# Docker deployment. Copy this file to .env, then change the three values below.
APP_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_choose_a_strong_admin_password

# Optional: set this after configuring a domain, for canonical SEO URLs.
# SITE_URL=https://example.com
# Optional advanced settings: JWT_SECRET, APP_BIND_ADDRESS, CORS_ALLOWED_ORIGINS,
# JWT_EXPIRE_HOURS, MAX_UPLOAD_MB, MAX_IMAGE_MB, MAX_VIDEO_MB, MAX_FILE_MB, TZ.
