# Docker production environment. Copy to .env and replace every CHANGE_ME value.
SITE_NAME="知识库"
SITE_URL=https://kb.example.com
CORS_ALLOWED_ORIGINS=https://kb.example.com
TRUSTED_PROXIES=172.16.0.0/12

# Required: a unique random value of at least 32 characters.
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_characters
JWT_EXPIRE_HOURS=72

# Used only when the database has no users yet. Use at least 12 characters.
ADMIN_USER=CHANGE_ME_admin
ADMIN_PASSWORD=CHANGE_ME_choose_a_strong_admin_password

# Upload limits in MiB.
MAX_UPLOAD_MB=1024
MAX_IMAGE_MB=20
MAX_VIDEO_MB=1024
MAX_FILE_MB=100