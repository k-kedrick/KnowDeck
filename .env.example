# 环境变量说明与开发默认配置示例 (.env.example)

# Development example only. Production must use .env.production with APP_ENV=production.
APP_ENV=development
PORT=3799
HOST=0.0.0.0
SITE_NAME="飞书风只读知识库"
# 公开站唯一基础 URL，用于 canonical、Open Graph、robots 和 sitemap；生产环境必须替换为真实 HTTPS 域名
SITE_URL=http://127.0.0.1:3799
# 本地 Go 动态 HTML Shell 默认读取 ../frontend/dist/index.html；容器环境由 Compose 配置内部 frontend URL
FRONTEND_INDEX_PATH=../frontend/dist/index.html
# 逗号分隔的跨域白名单；开发默认可使用 Vite 本地端口
CORS_ALLOWED_ORIGINS=http://localhost:3788,http://127.0.0.1:3788
TRUSTED_PROXIES=127.0.0.1,::1

# ==========================================
# 2. 存储与数据库配置
# ==========================================
# 数据文件目录与 SQLite 数据库存放路径
DATA_DIR=./data
DB_PATH=./data/app.db
# 媒体上传存储目录与限制 (单位 MB)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=1024
MAX_IMAGE_MB=20
MAX_VIDEO_MB=1024
MAX_FILE_MB=100

# ==========================================
# 3. JWT 认证与安全凭证 (生产环境请务必修改 JWT_SECRET)
# ==========================================
JWT_SECRET=development-only-secret-change-me-1234567890
JWT_EXPIRE_HOURS=72

# ==========================================
# 4. 管理员初始账号 (首领初始数据导入)
# ==========================================
ADMIN_USER=change-me
ADMIN_PASSWORD=change-me
