# Production environment example. Copy to .env.production and change secrets before deployment.

APP_ENV=production
PORT=8090
HOST=0.0.0.0
SITE_NAME="飞书风只读知识库"

DATA_DIR=/data
DB_PATH=/data/app.db
UPLOAD_DIR=/uploads
MAX_UPLOAD_MB=1024
MAX_IMAGE_MB=20
MAX_VIDEO_MB=1024
MAX_FILE_MB=100

# Required: set a unique random value with at least 32 characters.
JWT_SECRET=
JWT_EXPIRE_HOURS=72

# Required before first boot; use at least 12 characters.
ADMIN_USER=change-me
ADMIN_PASSWORD=change-me

# Comma-separated browser origins allowed to call authenticated APIs.
# Example: https://kb.example.com,https://www.kb.example.com
CORS_ALLOWED_ORIGINS=https://kb.example.com

# Requests reach Go only from the private Docker network through the frontend container.
TRUSTED_PROXIES=172.16.0.0/12
