# Local development only. This file is not used by Docker production deployment.
APP_ENV=development
PORT=3799
HOST=0.0.0.0
SITE_NAME="知识库"
SITE_URL=http://127.0.0.1:3799
FRONTEND_INDEX_PATH=../frontend/dist/index.html
CORS_ALLOWED_ORIGINS=http://localhost:3788,http://127.0.0.1:3788
TRUSTED_PROXIES=127.0.0.1,::1

DATA_DIR=./data
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=1024
MAX_IMAGE_MB=20
MAX_VIDEO_MB=1024
MAX_FILE_MB=100

JWT_SECRET=development-only-secret-change-me-1234567890
JWT_EXPIRE_HOURS=72
ADMIN_USER=change-me
ADMIN_PASSWORD=change-me
